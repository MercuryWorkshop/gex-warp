diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 1adb6ae4ee4..2ae47593644 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -335,10 +335,39 @@ static void gex_placement_handle_origin(void *data, struct gex_window_placement_
     {
         surface->placed_origin.x = x;
         surface->placed_origin.y = y;
+        /* A framed window is where its frame is: one shown elsewhere than
+         * Win32 put it was moved by its frame, and Win32 follows. */
+        if (surface->decorated && (x != surface->placed_at.x || y != surface->placed_at.y))
+            NtUserPostMessage(hwnd, WM_WAYLAND_MOVE, 0, 0);
     }
     wayland_win_data_release(win_data);
 }
 
+static void decoration_handle_configure(void *data, struct zxdg_toplevel_decoration_v1 *decoration,
+                                        uint32_t mode)
+{
+    HWND hwnd = data;
+    struct wayland_win_data *win_data;
+    BOOL refused = FALSE;
+
+    TRACE("hwnd=%p mode=%u\n", hwnd, mode);
+
+    if (mode != ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE) return;
+    if (!(win_data = wayland_win_data_get(hwnd))) return;
+    if (!win_data->decoration_refused && win_data->wayland_surface &&
+        win_data->wayland_surface->zxdg_toplevel_decoration_v1 == decoration)
+        win_data->decoration_refused = refused = TRUE;
+    wayland_win_data_release(win_data);
+
+    /* Win32 draws the frame after all: the window's rects again. */
+    if (refused) NtUserPostMessage(hwnd, WM_WAYLAND_FRAME, 0, 0);
+}
+
+static const struct zxdg_toplevel_decoration_v1_listener decoration_listener =
+{
+    decoration_handle_configure,
+};
+
 /* A window Win32 activated before it had a placement: WAYLAND_ActivateWindow
  * found nothing to tell then (ShowWindow activates a window before the
  * WindowPosChanged that makes its surface), and the compositor, which gives
@@ -360,9 +389,10 @@ static const struct gex_window_placement_v1_listener gex_placement_listener =
 /**********************************************************************
  *          wayland_surface_make_toplevel
  *
- * Gives the toplevel role to a plain wayland surface.
+ * Gives the toplevel role to a plain wayland surface; decorated, one the
+ * compositor frames.
  */
-void wayland_surface_make_toplevel(struct wayland_surface *surface)
+void wayland_surface_make_toplevel(struct wayland_surface *surface, BOOL decorated)
 {
     WCHAR text[1024];
 
@@ -394,15 +424,31 @@ void wayland_surface_make_toplevel(struct wayland_surface *surface)
 
     wayland_surface_init_fractional_scale(surface, 1.0);
 
+    surface->decorated = decorated && wayland_frames_windows();
+    if (surface->decorated)
+    {
+        surface->zxdg_toplevel_decoration_v1 = zxdg_decoration_manager_v1_get_toplevel_decoration(
+            process_wayland.zxdg_decoration_manager_v1, surface->xdg_toplevel);
+        if (surface->zxdg_toplevel_decoration_v1)
+        {
+            zxdg_toplevel_decoration_v1_add_listener(surface->zxdg_toplevel_decoration_v1,
+                                                     &decoration_listener, surface->hwnd);
+            zxdg_toplevel_decoration_v1_set_mode(surface->zxdg_toplevel_decoration_v1,
+                                                 ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE);
+        }
+        else surface->decorated = FALSE;
+    }
+
     if (process_wayland.gex_window_placement_manager_v1)
     {
         surface->gex_placement = gex_window_placement_manager_v1_get_placement(
             process_wayland.gex_window_placement_manager_v1, surface->wl_surface);
         if (surface->gex_placement)
         {
-            /* Win32 draws the frame, and other windows name this one by its
-             * handle when they stack above or below it. */
-            gex_window_placement_v1_set_unmanaged(surface->gex_placement);
+            /* Win32 draws the frame, unless the compositor does, and other
+             * windows name this one by its handle when they stack above or
+             * below it. */
+            if (!surface->decorated) gex_window_placement_v1_set_unmanaged(surface->gex_placement);
             gex_window_placement_v1_set_stack_id(surface->gex_placement,
                                                  (UINT)(ULONG_PTR)surface->hwnd);
             surface->placed_at.x = surface->placed_at.y = INT_MIN;
@@ -549,6 +595,13 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
             gex_window_placement_v1_destroy(surface->gex_placement);
             surface->gex_placement = NULL;
         }
+        /* (before its toplevel, which it would otherwise outlive) */
+        if (surface->zxdg_toplevel_decoration_v1)
+        {
+            zxdg_toplevel_decoration_v1_destroy(surface->zxdg_toplevel_decoration_v1);
+            surface->zxdg_toplevel_decoration_v1 = NULL;
+        }
+        surface->decorated = FALSE;
         if (surface->xdg_toplevel_icon)
         {
             xdg_toplevel_icon_manager_v1_set_icon(
