         wayland_surface_make_subsurface(surface, owner_surface);
@@ -424,6 +430,76 @@ static BOOL is_window_managed(HWND hwnd, UINT swp_flags, BOOL fullscreen)
     return FALSE;
 }
 
+/***********************************************************************
+ *		wayland_frames_windows
+ *
+ * Whether the compositor frames top-level windows with a caption: one that
+ * offers xdg-decoration does, but one that places windows (gex) only when
+ * its host draws a frame around a placed window, as gex's HostWindows does,
+ * and says so to its programs: WINEGEX_FRAMES=1. Otherwise Win32 draws every
+ * frame, as on Windows.
+ */
+BOOL wayland_frames_windows(void)
+{
+    static int frames = -1;
+
+    if (!process_wayland.zxdg_decoration_manager_v1) return FALSE;
+    if (!process_wayland.gex_window_placement_manager_v1) return TRUE;
+    if (frames < 0)
+    {
+        const char *e = getenv("WINEGEX_FRAMES");
+        frames = e && e[0] == '1';
+    }
+    return frames;
+}
+
+/***********************************************************************
+ *		is_window_decorated
+ *
+ * Whether the compositor frames a top-level window of this style, given a
+ * compositor that frames windows: one with a caption, as the X11 driver has
+ * its window manager decorate. The rest (popups, menus, tooltips, tool and
+ * layered windows, borderless and fullscreen ones) Win32 draws as it is.
+ */
+static BOOL is_window_decorated(DWORD style, DWORD ex_style)
+{
+    if ((style & (WS_CHILD|WS_POPUP)) == WS_CHILD) return FALSE;
+    if (ex_style & (WS_EX_TOOLWINDOW|WS_EX_LAYERED)) return FALSE;
+    return (style & WS_CAPTION) == WS_CAPTION;
+}
+
+/***********************************************************************
+ *           WAYLAND_GetWindowStyleMasks
+ *
+ * The non-client parts the compositor draws, which Win32 then neither draws
+ * nor counts in the window's surface (its visible rect): the caption and the
+ * border of a decorated window. The "Decorated" value under
+ * HKCU\Software\Wine\X11 Driver (win32u's, for every driver) set to N
+ * leaves them to Win32 again.
+ */
+BOOL WAYLAND_GetWindowStyleMasks(HWND hwnd, UINT style, UINT ex_style, UINT *style_mask, UINT *ex_style_mask)
+{
+    struct wayland_win_data *data;
+    BOOL decorated;
+
+    if (!wayland_frames_windows()) return FALSE;
+
+    decorated = is_window_decorated(style, ex_style);
+    if (decorated && (data = wayland_win_data_get(hwnd)))
+    {
+        if (data->decoration_refused) decorated = FALSE;
+        wayland_win_data_release(data);
+    }
+
+    *style_mask = *ex_style_mask = 0;
+    if (decorated)
+    {
+        *style_mask = WS_CAPTION | WS_THICKFRAME;
+        *ex_style_mask = WS_EX_DLGMODALFRAME;
+    }
+    return TRUE;
+}
+
 /***********************************************************************
  *           WAYLAND_DestroyWindow
  */
@@ -481,6 +557,9 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     data->is_fullscreen = fullscreen;
     data->resizeable = swp_flags & WINE_SWP_RESIZABLE;
     data->managed = managed;
+    data->decorated = !EqualRect(&new_rects->window, &new_rects->visible) &&
+                      is_window_decorated(NtUserGetWindowLongW(hwnd, GWL_STYLE),
+                                          NtUserGetWindowLongW(hwnd, GWL_EXSTYLE));
 
     if (!surface)
     {
@@ -543,8 +622,9 @@ static void wayland_configure_window(HWND hwnd)
 
     state = surface->processing.state;
     /* Ignore size hints if we don't have a state that requires strict
-     * size adherence, in order to avoid spurious resizes. */
-    if (state)
+     * size adherence, in order to avoid spurious resizes. A window the
+     * compositor frames is sized by its frame, though. */
+    if (state || surface->decorated)
     {
         width = surface->processing.rect.right - surface->processing.rect.left;
         height = surface->processing.rect.bottom - surface->processing.rect.top;
@@ -611,6 +691,15 @@ static void wayland_configure_window(HWND hwnd)
 
     SetRect(&rect, 0, 0, width, height);
     rect = map_rect_from_surface(surface, rect);
+    /* A framed window's surface is inside its caption and border, which the
+     * window keeps around the size asked for. */
+    if (surface->decorated && width && height)
+    {
+        rect.right += (data->rects.window.right - data->rects.window.left) -
+                      (data->rects.visible.right - data->rects.visible.left);
+        rect.bottom += (data->rects.window.bottom - data->rects.window.top) -
+                       (data->rects.visible.bottom - data->rects.visible.top);
+    }
     OffsetRect(&rect, data->rects.window.left, data->rects.window.top);
 
     wayland_win_data_release(data);
@@ -642,6 +731,33 @@ static void wayland_configure_window(HWND hwnd)
     NtUserSetRawWindowPos(hwnd, rect, flags, FALSE);
 }
 
+/* A framed, placed window that its frame moved (the compositor shows it at
+ * an origin other than where Win32 put it): Win32 moves it there, its
+ * client area at the origin. Only the latest origin; a stale message does
+ * nothing. */
+static void wayland_move_window(HWND hwnd)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    RECT rect;
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if (!(surface = data->wayland_surface) || !surface->gex_placement || !surface->decorated ||
+        surface->placed_origin.x == INT_MIN ||
+        (surface->placed_origin.x == surface->placed_at.x && surface->placed_origin.y == surface->placed_at.y))
+    {
+        wayland_win_data_release(data);
+        return;
+    }
+    rect = data->rects.window;
+    OffsetRect(&rect, surface->placed_origin.x - data->rects.visible.left,
+               surface->placed_origin.y - data->rects.visible.top);
+    wayland_win_data_release(data);
+
+    TRACE("hwnd=%p to %s\n", hwnd, wine_dbgstr_rect(&rect));
+    NtUserSetRawWindowPos(hwnd, rect, SWP_NOSIZE | SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOACTIVATE, FALSE);
+}
+
 /**********************************************************************
  *           WAYLAND_WindowMessage
  */
@@ -673,6 +789,14 @@ LRESULT WAYLAND_WindowMessage(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
     case WM_WAYLAND_DND:
         wayland_dnd_message(hwnd, wp, lp);
         return 0;
+    case WM_WAYLAND_MOVE:
+        wayland_move_window(hwnd);
+        return 0;
+    case WM_WAYLAND_FRAME:
+        /* The compositor will not frame it: its rects with Win32's frame. */
+        NtUserSetWindowPos(hwnd, 0, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOSIZE | SWP_NOMOVE |
+                           SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOACTIVATE);
+        return 0;
     default:
         FIXME("got window msg %x hwnd %p wp %lx lp %lx\n", msg, hwnd, (long)wp, lp);
         return 0;
diff --git a/dlls/winewayland.drv/xdg-decoration-unstable-v1.xml b/dlls/winewayland.drv/xdg-decoration-unstable-v1.xml
new file mode 100644
index 00000000000..834f6568ac1
--- /dev/null
+++ b/dlls/winewayland.drv/xdg-decoration-unstable-v1.xml
@@ -0,0 +1,53 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="xdg_decoration_unstable_v1">
+  <description summary="who draws a toplevel's frame">
+    The interfaces of wayland-protocols' unstable/xdg-decoration (version
+    1): a client asks for each xdg_toplevel to be decorated by the
+    compositor (server-side) or by itself (client-side), and the compositor
+    says which it is to be.
+  </description>
+
+  <interface name="zxdg_decoration_manager_v1" version="1">
+    <request name="destroy" type="destructor"/>
+
+    <request name="get_toplevel_decoration">
+      <arg name="id" type="new_id" interface="zxdg_toplevel_decoration_v1"/>
+      <arg name="toplevel" type="object" interface="xdg_toplevel"/>
+    </request>
+  </interface>
+
+  <interface name="zxdg_toplevel_decoration_v1" version="1">
+    <enum name="error">
+      <entry name="unconfigured_buffer" value="0"/>
+      <entry name="already_constructed" value="1"/>
+      <entry name="orphaned" value="2"/>
+      <entry name="invalid_mode" value="3"/>
+    </enum>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the decoration object">
+        Destroyed before its xdg_toplevel. The compositor goes back to its
+        default decoration mode for the toplevel.
+      </description>
+    </request>
+
+    <enum name="mode">
+      <entry name="client_side" value="1" summary="the client draws its frame"/>
+      <entry name="server_side" value="2" summary="the compositor draws the frame"/>
+    </enum>
+
+    <request name="set_mode">
+      <arg name="mode" type="uint" enum="mode"/>
+    </request>
+
+    <request name="unset_mode"/>
+
+    <event name="configure">
+      <description summary="the mode to use">
+        The decoration mode the toplevel is to have, applied at the next
+        xdg_surface.configure.
+      </description>
+      <arg name="mode" type="uint" enum="mode"/>
+    </event>
+  </interface>
